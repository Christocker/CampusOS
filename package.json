{
  "name": "campusos",
  "version": "1.0.0",
  "private": true,
  "description": "CampusOS — a self-hosted student productivity platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
